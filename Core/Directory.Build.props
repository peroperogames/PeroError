<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Company>PeroPeroGames</Company>
    <Authors>peropero</Authors>
    <Product>PeroError</Product>
    <Version>0.3.0</Version>
    <UnityTargetFramework>netstandard2.1</UnityTargetFramework>
    <UnityRoslynTargetFramework>netstandard2.0</UnityRoslynTargetFramework>
    <UnityArtifactConfiguration>Release</UnityArtifactConfiguration>
    <UnityPluginsDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Unity\Plugins'))</UnityPluginsDir>
  </PropertyGroup>
</Project>