    </ItemGroup>

    <ItemGroup>
        <Analyzer Include="..\Generator\bin\$(Configuration)\netstandard2.0\PeroTools2.PeroError.Generator.dll"/>
        <Analyzer Include="..\Analyzers\bin\$(Configuration)\netstandard2.0\PeroTools2.PeroError.Analyzers.dll"/>
