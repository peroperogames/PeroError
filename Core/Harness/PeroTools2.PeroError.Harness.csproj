        <TargetFramework>net11.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <LangVersion>15</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Source\PeroTools2.PeroError.Core.csproj" />
        <ProjectReference Include="..\Generator\PeroTools2.PeroError.Generator.csproj" ReferenceOutputAssembly="false"/>
