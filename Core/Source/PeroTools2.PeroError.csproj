<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0;net11.0</TargetFrameworks>
    <AssemblyName>PeroTools2.PeroError</AssemblyName>
    <RootNamespace>PeroTools2.Error</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <IsPackable>true</IsPackable>
    <PackageId>PeroTools2.PeroError</PackageId>
    <Description>Result/Err style error handling for C#. Usable from Unity through Unity/Plugins.</Description>
    <PackageTags>error;result;unity;error-handling</PackageTags>
    <RepositoryUrl>https://github.com/Peroperogames/PeroError</RepositoryUrl>
    <LangVersion>preview</LangVersion>
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The generator/analyzer only take part in the build; do not reference them as normal assemblies -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\Generator\PeroTools2.PeroError.Generator.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\Analyzers\PeroTools2.PeroError.Analyzers.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Referenced via a static path plus an Analyzer item, instead of ProjectReference
      with OutputItemType="Analyzer": the latter is resolved only temporarily by MSBuild
      targets during the build, so Rider's editor model cannot see it.
    -->
    <Analyzer Include="$(MSBuildThisFileDirectory)..\Generator\bin\$(Configuration)\netstandard2.0\PeroTools2.PeroError.Generator.dll" />
    <Analyzer Include="$(MSBuildThisFileDirectory)..\Analyzers\bin\$(Configuration)\netstandard2.0\PeroTools2.PeroError.Analyzers.dll" />
  </ItemGroup>

  <Target Name="CopyUnityArtifacts" AfterTargets="Build" Condition="'$(TargetFramework)' == '$(UnityTargetFramework)'">
    <ItemGroup>
      <_UnityArtifact Include="$(TargetDir)$(AssemblyName).dll" />
      <_UnityArtifact Include="$(TargetDir)$(AssemblyName).xml" Condition="Exists('$(TargetDir)$(AssemblyName).xml')" />
      <_UnityArtifact Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    </ItemGroup>

    <MakeDir Directories="$(UnityPluginsDir)" />
    <Copy SourceFiles="@(_UnityArtifact)" DestinationFolder="$(UnityPluginsDir)" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="PeroError => Unity/Plugins\$(AssemblyName).dll ($(Configuration)|$(TargetFramework))" />
  </Target>

</Project>
