<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0;net8.0;netstandard2.1</TargetFrameworks>
        <IsPackable>true</IsPackable>
        <LangVersion>15</LangVersion>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageId>PeroTools2.PeroError</PackageId>
        <AssemblyName>PeroTools2.PeroError.Core</AssemblyName>
        <RootNamespace>PeroTools2.Error</RootNamespace>
        <Company>PeroperoGames</Company>
        <Copyright>© 2026 PeroperoGames</Copyright>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Description>Result/Err style error handling for C#. Usable from Unity through Unity/Plugins.</Description>
        <PackageTags>error;result;unity;error-handling</PackageTags>
        <RepositoryUrl>https://github.com/peroperogames/PeroError</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Nullable>enable</Nullable>
        <Version>0.2.0</Version>
        <AssemblyVersion>0.2.0</AssemblyVersion>
        <FileVersion>0.2.0</FileVersion>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\Generator\PeroTools2.PeroError.Generator.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"/>
        <ProjectReference Include="$(MSBuildThisFileDirectory)..\Analyzers\PeroTools2.PeroError.Analyzers.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false"/>
    </ItemGroup>

    <Target Name="AddRoslynComponentsToPackage" BeforeTargets="_GetPackageFiles">
        <MSBuild Projects="$(MSBuildThisFileDirectory)..\Generator\PeroTools2.PeroError.Generator.csproj"
                 Targets="GetTargetPath"
                 Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" ItemName="_RoslynComponentAssembly"/>
        </MSBuild>
        <MSBuild Projects="$(MSBuildThisFileDirectory)..\Analyzers\PeroTools2.PeroError.Analyzers.csproj"
                 Targets="GetTargetPath"
                 Properties="Configuration=$(Configuration)">
            <Output TaskParameter="TargetOutputs" ItemName="_RoslynComponentAssembly"/>
        </MSBuild>

        <ItemGroup>
            <_MissingRoslynComponent Include="@(_RoslynComponentAssembly)" Condition="!Exists('%(Identity)')"/>
        </ItemGroup>
        <Error Condition="'@(_MissingRoslynComponent)' != ''"
               Text="Pack failed: Missing Roslyn component @(_MissingRoslynComponent)."/>

        <ItemGroup>
            <None Include="@(_RoslynComponentAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
        </ItemGroup>
    </Target>

    <Target Name="CopyUnityArtifacts" AfterTargets="Build" Condition="'$(TargetFramework)' == '$(UnityTargetFramework)' and '$(Configuration)' == '$(UnityArtifactConfiguration)'">
        <ItemGroup>
            <_UnityArtifact Include="$(TargetDir)$(AssemblyName).dll"/>
            <_UnityArtifact Include="$(TargetDir)$(AssemblyName).xml" Condition="Exists('$(TargetDir)$(AssemblyName).xml')"/>
            <_UnityArtifact Include="$(TargetDir)$(AssemblyName).pdb" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')"/>
        </ItemGroup>
        <MakeDir Directories="$(UnityPluginsDir)"/>
        <Copy SourceFiles="@(_UnityArtifact)" DestinationFolder="$(UnityPluginsDir)" SkipUnchangedFiles="true"/>
        <Message Importance="high" Text="PeroError => Unity/Plugins\$(AssemblyName).dll ($(Configuration)|$(TargetFramework))"/>
    </Target>

</Project>